# Copy to .env for local development. All variables are optional.

# Shared secret required from callers as the `X-Api-Key` header. Leave unset for local dev.
HEALTHGRID_AI_API_KEY=

# Data-sufficiency threshold: non-zero observations required for a "Ready" forecast.
HEALTHGRID_AI_MIN_HISTORY_POINTS=14

# Default forecast horizon (days).
HEALTHGRID_AI_DEFAULT_HORIZON=7

# Reported alongside every prediction for versioning / rollback.
HEALTHGRID_AI_MODEL_VERSION=fastapi-baseline-1
